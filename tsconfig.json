{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cerradorexperto/*": [
        "./src/app/subdomains/cerradorexperto/*"
      ],
      "@liderexperto/*": [
        "./src/app/subdomains/liderexperto/*"
      ],
      "@info/*": [
        "./src/app/subdomains/info/*"
      ],
      "@lobosdeventas/*": [
        "./src/app/subdomains/lobosdeventas/*"
      ],
      "@totalscript/*": [
        "./src/app/subdomains/totalscript/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
